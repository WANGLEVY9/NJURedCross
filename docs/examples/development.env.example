# 南京大学红十字会平台：可分享的开发/测试环境示例
# 本文件只包含配置项、占位符和开发默认值，没有生产凭据。
# 从仓库根目录执行：cp docs/examples/development.env.example .env
# 已有 .env 时请先备份，再手动合并；不要覆盖已有配置。
# 无数据凭据时可以直接 npm run preview 或 npm run preview:workflow。
# 完整后端需要自行填写独立测试 Base 的 Token，并准备对应测试表结构。

# 1. 本地运行
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
PLATFORM_COOKIE_SECURE=false

# 2. 测试业务 Base（物资/活动/宣传等）
# URL 是服务入口，不是 API Token。可改为自己的测试 SeaTable 地址。
SEATABLE_SERVER_URL=https://table.nju.edu.cn
SEATABLE_API_TOKEN=replace-with-your-api-token
SEATABLE_BUSINESS_BASE_UUID=
# 可选：数据中心默认子表；为空时从元数据选择。
SEATABLE_TABLE=

# 3. 志愿服务测试 Base（可选）
# Token 和 UUID 必须属于同一个测试 Base。
SEATABLE_VOLUNTEER_API_TOKEN=
SEATABLE_VOLUNTEER_BASE_UUID=
SEATABLE_VOLUNTEER_NOTICE_TABLE=报名通知
SEATABLE_BLOOD_SOURCE_TABLE=市血液献血车排班表（汇总底表）
# 默认关闭志愿活动写入试点；启用前确认代码中的测试 UUID 白名单。
# 仅配置任意测试 Base 并不会通过工作流的 UUID 检查。
PLATFORM_WORKFLOW_MODE=disabled
PLATFORM_TEST_WORKFLOW=false
WORKFLOW_EVIDENCE_DIR=.workflow-evidence

# 4. 独立私有身份测试 Base（注册/登录/验证码/个人资料私有保存）
# 建议完整联调使用这一连接，由维护者初始化测试账号与表结构。
# 留空仅用于本地旧版兼容模式，身份数据将回退到测试业务 Base。
SEATABLE_IDENTITY_API_TOKEN=
SEATABLE_IDENTITY_BASE_UUID=

# 5. 个人资料同步写入测试 Base（可选）
# 必须明确填写写入目的地，不以只读志愿报表 Token 代替。
SEATABLE_PROFILE_API_TOKEN=
SEATABLE_PROFILE_BASE_UUID=

# 6. 会话密钥：每位开发者在本机生成，不要共用示例密钥。
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PLATFORM_SESSION_SECRET=replace-with-at-least-32-random-characters
PLATFORM_SESSION_TTL_HOURS=8

# 7. 本地兼容账号兜底（仅未配置私有身份连接且账号表无有效账号时生效）
# 为空时使用下方单管理员配置，不要求创建本地账号 JSON 文件。
PLATFORM_ACCOUNTS_FILE=
PLATFORM_ADMIN_USERNAME=local-admin
PLATFORM_ADMIN_PASSWORD=replace-with-your-local-test-password
# 如需要多个合成账号，可改为 .platform-accounts.json。
# JSON 格式参见 docs/GETTING_STARTED.md；该文件不应提交到仓库。

# 8. 校园邮箱与请求额度
PUBLIC_EMAIL_DOMAINS=nju.edu.cn,smail.nju.edu.cn
PUBLIC_WRITE_LIMIT_PER_HOUR=12

# 9. 邮件联调（默认不外发邮件）
# 开发模式留空时验证码走服务端日志；SMTP_* 填齐后会实际发信。
# 邮箱服务如要求 SMTP 授权码，SMTP_PASSWORD 填授权码而非网页登录密码。
# 如需收信联调，请填写开发者自有测试邮箱或邮件捕获服务的配置。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MATERIALS_REMINDER_FROM=
MATERIALS_REMINDER_ENABLED=false
MATERIALS_REMINDER_INTERVAL_MINUTES=15

# 10. NJUBox 附件测试（可选）
NJUBOX_SERVER_URL=https://box.nju.edu.cn
NJUBOX_API_TOKEN=
NJUBOX_REPO_ID=
NJUBOX_UPLOAD_DIR=/测试/红十字会/活动策划案

# 11. 温暖连接（准备测试表结构后才开启）
WARMTH_BIRTHDAY_ENABLED=false
WARMTH_DELIVERY_ENABLED=false
WARMTH_DELIVERY_HOUR=8
WARMTH_LOCK_REQUIRED=true
WARMTH_LOCK_RETRY_MS=30000
WARMTH_STATE_MAX_ROWS=20000
WARMTH_MORNING_ENABLED=false
