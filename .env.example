# NJU Table is a self-hosted SeaTable Enterprise instance.
SEATABLE_SERVER_URL=https://table.nju.edu.cn

# Never commit the real token. Copy this file to .env and fill it locally.
SEATABLE_API_TOKEN=replace-with-your-api-token

# Optional. If omitted, the data centre lets you choose a table from metadata.
SEATABLE_TABLE=

# Optional second SeaTable base for volunteer-service data. Keep the token server-side.
SEATABLE_VOLUNTEER_API_TOKEN=
SEATABLE_VOLUNTEER_BASE_UUID=

# Local web server
PORT=3000

# Local platform administrator. Use a unique long password and a random secret
# of at least 32 characters. Never commit the filled .env file.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional multi-account mode. Points to a Git-ignored JSON array of accounts.
PLATFORM_ADMIN_ACCOUNTS_FILE=
PLATFORM_SESSION_SECRET=replace-with-at-least-32-random-characters
PLATFORM_SESSION_TTL_HOURS=8

# Public portal guardrails.
# Comma-separated email suffixes accepted by the public submission endpoints.
# Leave blank to accept any domain (not recommended for a campus service).
PUBLIC_EMAIL_DOMAINS=nju.edu.cn,smail.nju.edu.cn
# Per-client-address write budget for each public action bucket, per hour.
PUBLIC_WRITE_LIMIT_PER_HOUR=12

# Optional overdue email reminder. Leave blank to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MATERIALS_REMINDER_FROM=
MATERIALS_REMINDER_INTERVAL_MINUTES=15
