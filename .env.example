# NJU Table is a self-hosted SeaTable Enterprise instance.
SEATABLE_SERVER_URL=https://table.nju.edu.cn

# Never commit the real token. Copy this file to .env and fill it locally.
SEATABLE_API_TOKEN=replace-with-your-api-token

# Optional. If omitted, the data centre lets you choose a table from metadata.
SEATABLE_TABLE=

# Optional second SeaTable base for volunteer-service data. Keep the token server-side.
SEATABLE_VOLUNTEER_API_TOKEN=
SEATABLE_VOLUNTEER_BASE_UUID=

# Local web server; production requires a private identity Base and HTTPS.
NODE_ENV=development
PORT=3000
PLATFORM_COOKIE_SECURE=false

# Platform accounts. Two roles exist:
#   platform_admin -> operations console (/console) and the portal
#   member         -> public portal only
# Point PLATFORM_ACCOUNTS_FILE at a Git-ignored JSON array of
# { username, password, role, label } objects. See the README for the shape and
# for the local test accounts.
PLATFORM_ACCOUNTS_FILE=.platform-accounts.json

# Single-account fallback, used only when PLATFORM_ACCOUNTS_FILE is blank: it
# creates one platform_admin with the credentials below.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Sessions. The secret must be at least 32 random characters.
PLATFORM_SESSION_SECRET=replace-with-at-least-32-random-characters
PLATFORM_SESSION_TTL_HOURS=8

# Registration/reset: 8–72 characters, uppercase + lowercase + digit + symbol.
# See public/app/core/password-policy.js. Existing sign-in passwords stay compatible.

# Public portal guardrails.
# Comma-separated email suffixes accepted by the public submission endpoints.
# Empty values fall back to the campus defaults.
PUBLIC_EMAIL_DOMAINS=nju.edu.cn,smail.nju.edu.cn
# Per-client-address write budget for each public action bucket, per hour.
PUBLIC_WRITE_LIMIT_PER_HOUR=12

# Outbound mail. Used for the overdue-reminder job and for the identity layer's
# e-mail verification codes. When left blank, code delivery falls back to the
# development console transport (the code is printed to the server log) and the
# overdue reminder job stays disabled — never use that in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MATERIALS_REMINDER_FROM=
MATERIALS_REMINDER_INTERVAL_MINUTES=15

# njubox (NJU Box is a self-hosted Seafile Enterprise instance, so the contract
# is the Seafile Web API at <server>/api2/). Leave the token blank to keep
# attachment features disabled; the status endpoint still probes the server
# anonymously.
NJUBOX_SERVER_URL=https://box.nju.edu.cn
NJUBOX_API_TOKEN=
NJUBOX_REPO_ID=
NJUBOX_UPLOAD_DIR=/红十字会/活动策划案

# Aliyun OSS (object storage for submission attachments). Server-side relay
# uploads keep the browser talking only to njuredcross.cn, so the CSP stays
# locked to connect-src 'self'. Leave the AccessKey blank to keep attachment
# uploads disabled; the status endpoint still reports configured:false.
# Use a dedicated RAM user restricted to this single bucket.
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-nanjing
# Optional endpoint override (without the bucket prefix), e.g. the internal
# endpoint when the server runs on an ECS instance in the same region.
ALIYUN_OSS_ENDPOINT=
# Object key prefix inside the bucket; leading/trailing slashes are ignored.
ALIYUN_OSS_UPLOAD_PREFIX=submissions/
# Seconds a presigned download link stays valid (1..604800, default 900).
ALIYUN_OSS_LINK_TTL_SECONDS=900

# Explicit opt-in for automatic overdue material reminders.
MATERIALS_REMINDER_ENABLED=false

# Independent private identity Base; mandatory in production.
# Leave blank ONLY for isolated local legacy/bootstrap testing. See docs/GETTING_STARTED.md.
SEATABLE_IDENTITY_API_TOKEN=
SEATABLE_IDENTITY_BASE_UUID=
SEATABLE_BUSINESS_BASE_UUID=

# Dedicated profile write Base. Keep independent from read-only volunteer reports.
SEATABLE_PROFILE_API_TOKEN=
SEATABLE_PROFILE_BASE_UUID=

# Only the explicitly allowlisted volunteer test Base supports this pilot.
PLATFORM_TEST_WORKFLOW=false

# Private attendance photos; production default is /var/lib/njuredcross-evidence.
# Never place this under public/. Include the directory in protected backups.
WORKFLOW_EVIDENCE_DIR=
