{
  "name": "njuredcross-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NJU Red Cross platform: public service portal + operations console on a SeaTable data core",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "check": "node scripts/check-project.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:data-boundary": "node scripts/smoke-data-boundary.mjs",
    "test:permissions": "node scripts/test-permission-contract.mjs",
    "permissions:dry-run": "node --env-file=.env scripts/preview-permission-schema.mjs",
    "smoke:identity": "node scripts/smoke-identity.mjs",
    "smoke:events": "node scripts/smoke-events.mjs",
    "audit:data": "node --env-file=.env scripts/audit-data-accuracy.mjs",
    "profile-schema:preview": "node --env-file=.env scripts/preview-profile-schema.mjs",
    "accounts:dry-run": "node --env-file=.env scripts/run-coordinated-script.mjs apply-account-schema.mjs",
    "accounts:apply": "node --env-file=.env scripts/run-coordinated-script.mjs apply-account-schema.mjs",
    "notices:dry-run": "node --env-file=.env scripts/run-coordinated-script.mjs apply-notice-schema.mjs",
    "notices:apply": "node --env-file=.env scripts/run-coordinated-script.mjs apply-notice-schema.mjs",
    "events:dry-run": "node --env-file=.env scripts/preview-event-schema.mjs",
    "events:apply": "node --env-file=.env scripts/run-coordinated-script.mjs apply-event-schema.mjs",
    "state:dry-run": "node --env-file=.env scripts/run-coordinated-script.mjs apply-state-schema.mjs",
    "state:apply": "node --env-file=.env scripts/run-coordinated-script.mjs apply-state-schema.mjs",
    "state:clean-preview": "node --env-file=.env scripts/run-coordinated-script.mjs clean-test-rows.mjs",
    "state:purge-preview": "node --env-file=.env scripts/run-coordinated-script.mjs clean-test-rows.mjs --purge",
    "test:identity": "node scripts/test-identity-flow.mjs",
    "test:volunteer-profile": "node scripts/test-volunteer-profile.mjs",
    "profile-mapping:preview": "node --env-file=.env scripts/run-coordinated-script.mjs extend-volunteer-profile-schema.mjs",
    "test": "npm run test:permissions && npm run test:identity && npm run test:volunteer-profile && npm run test:node",
    "test:infrastructure": "node --test tests/infrastructure.test.mjs",
    "verify": "npm run check && npm run lint && npm test",
    "audit:dependencies": "npm audit --omit=dev",
    "lint": "eslint . --max-warnings=0",
    "preview": "node scripts/preview-site.mjs",
    "preview:workflow": "node scripts/preview-workflow.mjs",
    "workflow:schema:preview": "node --env-file=.env scripts/run-coordinated-script.mjs apply-workflow-schema.mjs",
    "workflow:inspect": "node --env-file=.env scripts/inspect-volunteer-workflow.mjs",
    "test:node": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "nodemailer": "10.0.13",
    "qrcode": "^1.5.4",
    "seatable-api": "1.0.46",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MPL-2.0",
  "overrides": {
    "seatable-api": {
      "axios": "1.20.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
