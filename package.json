{
  "name": "njuredcross-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NJU Red Cross platform: public service portal + operations console on a SeaTable data core",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "check": "node --check server.js && find public -name '*.js' -print0 | xargs -0 -n1 node --check && find scripts -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "smoke:public": "node scripts/smoke-public.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:identity": "node scripts/smoke-identity.mjs",
    "smoke:events": "node scripts/smoke-events.mjs",
    "accounts:dry-run": "node --env-file=.env scripts/apply-account-schema.mjs",
    "accounts:apply": "node --env-file=.env scripts/apply-account-schema.mjs",
    "notices:dry-run": "node --env-file=.env scripts/apply-notice-schema.mjs",
    "notices:apply": "node --env-file=.env scripts/apply-notice-schema.mjs",
    "events:dry-run": "node --env-file=.env scripts/preview-event-schema.mjs",
    "events:apply": "node --env-file=.env scripts/apply-event-schema.mjs",
    "state:dry-run": "node --env-file=.env scripts/apply-state-schema.mjs",
    "state:apply": "node --env-file=.env scripts/apply-state-schema.mjs",
    "state:clean-preview": "node --env-file=.env scripts/clean-test-rows.mjs",
    "state:purge-preview": "node --env-file=.env scripts/clean-test-rows.mjs --purge"
  },
  "dependencies": {
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "seatable-api": "1.0.46"
  }
}
