[Unit]
Description=Check NJURedCross activity project relationships
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/njuredcross
ExecStart=/usr/bin/node --env-file=/opt/njuredcross/.env scripts/check-activity-relationships.mjs
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
